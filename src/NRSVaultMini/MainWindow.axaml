<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NRSVaultMini"
        x:Class="NRSVaultMini.MainWindow"
        x:DataType="local:MainViewModel"
        Title="{Binding Title}"
        Width="1500" Height="900" MinWidth="1000" MinHeight="600"
        Background="#F7F7F7"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- ===== Toolbar ===== -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto,16,Auto,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="Collection folder" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Grid.Column="1" Text="{Binding RootFolder}" IsEnabled="{Binding IsIdle}" />
          <Button Grid.Column="2" Content="…" Margin="4,0,0,0" Click="BrowseRoot_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Choose the collection folder" />
          <TextBlock Grid.Column="4" Text="nes20db.xml" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Grid.Column="5" Text="{Binding XmlPath}" IsEnabled="{Binding IsIdle}" />
          <Button Grid.Column="6" Content="…" Margin="4,0,0,0" Click="BrowseXml_Click" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Choose nes20db.xml" />
          <Button Grid.Column="7" Content="Load DB" Margin="4,0,0,0" Click="LoadDb_Click" IsEnabled="{Binding IsIdle}" />
        </Grid>

        <WrapPanel Orientation="Horizontal">
          <Button Content="Scan" Click="Scan_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0" FontWeight="SemiBold"
                  ToolTip.Tip="Read and hash every file in the collection folder (unchanged files come from cache)" />
          <Button Content="Scan sources" Click="ScanSources_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0"
                  ToolTip.Tip="Search the source folders (recursively, read-only) for ROMs that can fill gaps in the collection" />
          <Button Content="{Binding FixButtonText}" Click="Fix_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0" FontWeight="SemiBold"
                  ToolTip.Tip="Extract archives, write correct NES 2.0 headers, rebuild to the XML folder layout, move unknown files" />
          <Button Content="Generate DAT…" Click="Dat_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0" />
          <Button Content="Split DAT…" Click="SplitDat_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0"
                  ToolTip.Tip="Write a DAT of the split set: .prg and .chr per ROM, hashes straight from nes20db.xml" />
          <Button Content="Export split files…" Click="SplitExport_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0"
                  ToolTip.Tip="Cut every available ROM into .prg / .chr files in a separate folder (respects TRIAL RUN)" />
          <Button Content="Export report…" Click="Report_Click" IsEnabled="{Binding IsIdle}" Margin="0,0,4,0" />
          <Button Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding IsBusy}" Margin="0,0,16,0" />

          <Border Background="#FFF3E0" BorderBrush="#FB8C00" BorderThickness="1" CornerRadius="3" Padding="6,0" Margin="0,0,16,0">
            <CheckBox IsChecked="{Binding TrialRun}" IsEnabled="{Binding IsIdle}" FontWeight="Bold"
                      Content="TRIAL RUN (no files changed)"
                      ToolTip.Tip="When on, Fix / Rebuild only logs what it would do" />
          </Border>

          <CheckBox Content="Rebuild to XML structure" IsChecked="{Binding Rebuild}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0"
                    ToolTip.Tip="Copy/move ROMs found elsewhere to the exact paths listed in nes20db.xml" />
          <CheckBox Content="Unknown → __Unknown" IsChecked="{Binding MoveUnknown}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0"
                    ToolTip.Tip="Move files not in nes20db.xml into the _Unknown folder" />
          <CheckBox Content="Surplus copies → __Duplicates" IsChecked="{Binding MoveDuplicates}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0"
                    ToolTip.Tip="Move extra copies of known ROMs that sit outside the XML layout into _Duplicates" />
          <CheckBox Content="Remove empty folders" IsChecked="{Binding RemoveEmptyFolders}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0" />
          <CheckBox Content="Fill from source folders" IsChecked="{Binding UseSources}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0"
                    ToolTip.Tip="Copy matching ROMs found in the source folders into the collection (sources are never changed)" />
        </WrapPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,16,Auto,Auto,*,Auto,*">
          <CheckBox Grid.Column="0" Content="Back up originals to" IsChecked="{Binding BackupEnabled}" IsEnabled="{Binding IsIdle}" Margin="0,0,6,0"
                    ToolTip.Tip="Copy every file before it is overwritten or removed" />
          <TextBox Grid.Column="1" Text="{Binding BackupFolder}" IsEnabled="{Binding IsIdle}" />
          <Button Grid.Column="2" Content="…" Margin="4,0,0,0" Click="BrowseBackup_Click" IsEnabled="{Binding IsIdle}" />
          <CheckBox Grid.Column="4" Content="DAT: include unverified (size + CRC32)" IsChecked="{Binding DatIncludeUnverified}" IsEnabled="{Binding IsIdle}" Margin="0,0,10,0"
                    ToolTip.Tip="Also list ROMs that are not verified in the collection, with size and computed CRC32 only, flagged verified=false" />
          <TextBlock Grid.Column="5" Text="DAT name" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Grid.Column="6" Text="{Binding DatName}" IsEnabled="{Binding IsIdle}" />
          <TextBlock Grid.Column="7" Text="Author" VerticalAlignment="Center" Margin="10,0,6,0" />
          <TextBox Grid.Column="8" Text="{Binding DatAuthor}" IsEnabled="{Binding IsIdle}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- ===== Status bar ===== -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="8,3">
      <Grid ColumnDefinitions="220,*">
        <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Height="12" MinHeight="12" Margin="0,0,10,0" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!-- ===== Stats sidebar ===== -->
    <Border DockPanel.Dock="Left" Width="235" Background="White" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
      <ScrollViewer Padding="10,2,10,10">
        <ItemsControl ItemsSource="{Binding Stats}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:StatItem">
              <Panel>
                <TextBlock Classes="statHeader" Text="{Binding Label}" IsVisible="{Binding IsHeader}" />
                <Border IsVisible="{Binding !IsHeader}" Background="Transparent" Padding="0,1" CornerRadius="2"
                        Cursor="{Binding IsClickable, Converter={x:Static local:Converters.HandCursor}}"
                        Tapped="Stat_Tapped"
                        ToolTip.Tip="{Binding FilterKey, Converter={x:Static local:Converters.FilterTip}}">
                  <Grid ColumnDefinitions="14,*,Auto">
                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="statLabel" Text="{Binding Label}" />
                    <TextBlock Grid.Column="2" Classes="statLabel" Text="{Binding Value}" FontWeight="SemiBold" />
                  </Grid>
                </Border>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- ===== Main area: tree | details, log below ===== -->
    <Grid RowDefinitions="*,5,170" ColumnDefinitions="*,5,360">

      <TabControl Grid.Row="0" Grid.Column="0" Padding="0" Margin="0">
        <TabItem Header="Collection" FontSize="13">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="4,4,4,4">
              <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search name, path, note, CRC32 or SHA1…" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" Margin="6,0,0,0" MinWidth="200" />
              <Button Grid.Column="2" Content="Expand all" Click="ExpandAll_Click" Margin="6,0,0,0" />
              <Button Grid.Column="3" Content="Collapse all" Click="CollapseAll_Click" Margin="4,0,0,0" />
              <TextBlock Grid.Column="4" Text="{Binding VisibleSummary}" VerticalAlignment="Center" Margin="10,0,4,0" FontSize="12" Foreground="#555" />
            </Grid>

            <DataGrid x:Name="Tree" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                      CanUserReorderColumns="False" SelectionMode="Single" HeadersVisibility="Column"
                      Sorting="Tree_Sorting" DoubleTapped="Tree_DoubleTapped">
              <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="local:TreeNode">
                  <Setter Property="Background" Value="{Binding RowBrush}" />
                  <Setter Property="FontWeight" Value="{Binding Weight}" />
                </Style>
              </DataGrid.Styles>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name ▲" Width="*" MinWidth="250" SortMemberPath="name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="local:TreeNode">
                      <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" Width="14" Margin="2,0,0,0" TextAlignment="Center" Cursor="Hand"
                                   Tapped="Expander_Tapped" FontSize="12" />
                        <TextBlock Text="{Binding Icon}" Margin="0,0,4,0" FontSize="11" />
                        <TextBlock Text="{Binding Name}" Margin="0" />
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120" SortMemberPath="status" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="85" SortMemberPath="size" />
                <DataGridTextColumn Header="CRC32" Binding="{Binding Crc}" Width="84" SortMemberPath="crc" FontFamily="Consolas" />
                <DataGridTextColumn Header="SHA1" Binding="{Binding Sha1}" Width="300" SortMemberPath="sha1" FontFamily="Consolas" />
                <DataGridTextColumn Header="Mapper" Binding="{Binding Mapper}" Width="96" SortMemberPath="mapper" />
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="260" SortMemberPath="note" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem Header="Source folders" FontSize="13">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4">
              <ListBox Grid.Column="0" ItemsSource="{Binding SourceFolders}" SelectedItem="{Binding SelectedSourceFolder}"
                       Height="96" FontSize="12" BorderBrush="#D0D0D0" BorderThickness="1">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,1" />
                    <Setter Property="MinHeight" Value="18" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
              <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                <Button Content="Add folder…" Click="AddSource_Click" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" />
                <Button Content="Remove" Click="RemoveSource_Click" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" />
                <Button Content="Scan sources" Click="ScanSources_Click" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="4,0,4,4">
              <CheckBox Content="Only show ROMs that fill a gap" IsChecked="{Binding SourcesOnlyNeeded}" />
              <TextBlock Grid.Column="1" Text="{Binding SourceSummary}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="#555" />
            </Grid>
            <DataGrid x:Name="SourcesGrid" ItemsSource="{Binding SourceMatchList}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" CanUserResizeColumns="True" HeadersVisibility="Column">
              <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="local:SourceMatchVm">
                  <Setter Property="Background" Value="{Binding RowBrush}" />
                </Style>
              </DataGrid.Styles>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Result" Binding="{Binding Fills}" Width="95" />
                <DataGridTextColumn Header="nes20db path" Binding="{Binding Target}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="85" SortMemberPath="Size" />
                <DataGridTextColumn Header="Found as" Binding="{Binding Kind}" Width="140" />
                <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="72" SortMemberPath="Copies" />
                <DataGridTextColumn Header="Source file" Binding="{Binding Source}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <TabItem Header="Unknown &amp; surplus files" FontSize="13">
          <DataGrid x:Name="ExtrasGrid" ItemsSource="{Binding Extras}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserSortColumns="True" CanUserResizeColumns="True" HeadersVisibility="Column" LoadingRow="Extras_LoadingRow">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100" />
              <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
              <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="90" SortMemberPath="Size" />
              <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="320" />
              <DataGridTextColumn Header="SHA1" Binding="{Binding Sha1}" Width="300" FontFamily="Consolas" />
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Row="0" Grid.Column="1" ResizeDirection="Columns" Background="#E0E0E0" />

      <Border Grid.Row="0" Grid.Column="2" Background="White">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Details" FontWeight="Bold" Margin="8,6,8,2" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Details}" FontFamily="Consolas" FontSize="11.5" Margin="8,2,8,8" TextWrapping="NoWrap" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ResizeDirection="Rows" Background="#E0E0E0" />

      <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="8,3">
          <TextBlock Text="Log" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Clear" Click="ClearLog_Click" Margin="0,0,4,0" Padding="8,1" />
          <Button Grid.Column="2" Content="Export log…" Click="ExportLog_Click" Padding="8,1" />
        </Grid>
        <ListBox x:Name="LogList" ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11.5">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,0" />
              <Setter Property="MinHeight" Value="16" />
            </Style>
          </ListBox.Styles>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
